# EmailJS Configuration for Sanjay's Portfolio
# Sign up / Log in at https://dashboard.emailjs.com/

# 1. Email Services -> Add New Service (e.g., Gmail) -> Copy Service ID
VITE_EMAILJS_SERVICE_ID=

# 2. Email Templates -> Create New Template -> Copy Template ID
VITE_EMAILJS_TEMPLATE_ID=

# 3. Account -> General -> API Keys -> Copy Public Key
VITE_EMAILJS_PUBLIC_KEY=
